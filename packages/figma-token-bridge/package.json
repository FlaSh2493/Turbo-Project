{
  "name": "figma-token-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Figma Variables ↔ code design token transformation layer (DTCG JSON → CSS + TypeScript)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "figma-token-bridge": "./dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "style-dictionary": "^5.3.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@turbo-project/tsconfig": "workspace:*",
    "@types/node": "^25.0.3",
    "@vitest/coverage-istanbul": "^4.0.16",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@10.24.0"
}
