{
  "name": "@turbo-project/afds-registry",
  "private": true,
  "version": "1.6.1",
  "description": "Component sharing platform for AFDS",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:registry",
    "generate:registry": "tsx scripts/generate-manifest.ts && prettier --write ../../registry.json",
    "validate:registry": "shadcn registry validate registry.json --cwd ../..",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0 && eslint . --max-warnings 0",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@internationalized/date": "^3.12.1",
    "@turbo-project/afds": "workspace:*",
    "@storybook/react": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.575.0",
    "oxlint": "1.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "4.19.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
