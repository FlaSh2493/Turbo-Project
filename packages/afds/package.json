{
  "name": "@turbo-project/afds",
  "version": "1.2.1",
  "description": "Agent Friendly Design System",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./tokens/*.css",
    "./dist/styles/index.css",
    "./dist/styles/scoped.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/utils": {
      "source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./lib/compose-event-handlers": {
      "source": "./src/lib/compose-event-handlers.ts",
      "types": "./dist/lib/compose-event-handlers.d.ts",
      "default": "./dist/lib/compose-event-handlers.js"
    },
    "./bricks": {
      "source": "./src/bricks/index.ts",
      "types": "./dist/bricks/index.d.ts",
      "default": "./dist/bricks/index.js"
    },
    "./hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./scope": {
      "source": "./src/scope/index.ts",
      "types": "./dist/scope/index.d.ts",
      "default": "./dist/scope/index.js"
    },
    "./headless": {
      "source": "./src/headless/index.ts",
      "types": "./dist/headless/index.d.ts",
      "default": "./dist/headless/index.js"
    },
    "./styles": {
      "source": "./src/styles/index.css",
      "default": "./dist/styles/index.css"
    },
    "./styles/scoped": {
      "default": "./dist/styles/scoped.css"
    },
    "./postcss": {
      "source": "./src/postcss/index.ts",
      "types": "./dist/postcss/index.d.ts",
      "default": "./dist/postcss/index.js"
    },
    "./manifest.json": "./dist/manifest.json",
    "./llms.txt": "./dist/llms.txt",
    "./schemas": {
      "source": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./tokens": "./tokens/index.css",
    "./tokens/fonts": "./tokens/fonts.css",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.semantic.css": "./tokens/tokens.semantic.css",
    "./tokens.custom.css": "./tokens/tokens.custom.css",
    "./tokens.motion.css": "./tokens/tokens.motion.css",
    "./tokens.effects.css": "./tokens/tokens.effects.css"
  },
  "files": [
    "dist",
    "tokens",
    "src"
  ],
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "tsx scripts/build.ts && pnpm verify:exports",
    "verify:exports": "tsx scripts/verify-exports.ts",
    "verify:docs": "tsx scripts/verify-doc-citations.ts",
    "verify:docs:citations": "tsx scripts/verify-doc-citations.ts --no-imports",
    "check-types": "tsc --noEmit",
    "lint": "tsx scripts/lint-ratchet.ts",
    "test": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "generate:manifest": "tsx scripts/generate-manifest.ts",
    "generate:tokens": "tsx ../../packages/figma-token-bridge/cli/index.ts generate --config token-bridge.config.ts",
    "generate:schemas": "tsx scripts/generate-schemas.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-aria": "^3.48.0",
    "react-stately": "^3.46.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/cli": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^4.0.16",
    "eslint-plugin-unused-imports": "4.3.0",
    "figma-token-bridge": "workspace:*",
    "jsdom": "^26.0.0",
    "oxlint": "1.87.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.4.1",
    "lucide-react": "^0.575.0",
    "postcss": "^8.5.6",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.1.18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "lucide-react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "@base-ui/react": {
      "optional": false
    },
    "tailwindcss": {
      "optional": false
    },
    "postcss": {
      "optional": true
    }
  }
}
