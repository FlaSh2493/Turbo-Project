{
  "extends": ["@turbo-project/tsconfig/tsconfig.base.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@turbo-project/afds": ["./src/index.ts"],
      "@turbo-project/afds/*": ["./src/*"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"],

    // 타입을 값 import 로 섞는 것을 막는다 — 공유 설정의 `isolatedModules` 는 이것을
    // 요구하지 않는다(타입 **재수출**만 막는다). 그래서 `import { ReactNode }` 형태가
    // 여기까지 통과했다.
    //
    // afds 는 패키지로 배포되므로 소비처는 `dist/*.d.ts` 를 소비하고 이 소스를
    // 컴파일하지 않는다 — 즉 이 플래그는 소비처 호환이 아니라 **내부 일관성**을 위한
    // 것이다. 소스가 복사되는 afds-registry 쪽은 이유가 다르다(#178).
    "verbatimModuleSyntax": true
  },
  "include": ["."],
  "exclude": ["node_modules", "dist", ".turbo"]
}
