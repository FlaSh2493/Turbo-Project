{
  "name": "@turbo-project/storybook-app",
  "version": "1.0.25",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "STORYBOOK_SOURCE=true storybook dev --port 6007",
    "storybook-built": "pnpm --filter @turbo-project/afds build && storybook dev --port 6007",
    "build-storybook": "pnpm --filter @turbo-project/afds build && storybook build",
    "lint": "oxlint -c ../../.oxlintrc.json --max-warnings 0 && eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@turbo-project/afds": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.15",
    "@storybook/addon-interactions": "8.6.15",
    "@storybook/addon-links": "8.6.15",
    "@storybook/blocks": "8.6.15",
    "@storybook/react": "8.6.15",
    "@storybook/react-vite": "8.6.15",
    "@storybook/test": "8.6.15",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "chromatic": "^15.2.0",
    "oxlint": "1.87.0",
    "storybook": "^8.6.15",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^4.0.16"
  }
}
